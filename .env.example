# ---- Game server (apps/server) -------------------------------------------------------------
PORT=2567
# Comma-separated web origins allowed to call the server and open WebSockets (exact match).
CLIENT_ORIGINS=http://localhost:5173
# Believe X-Forwarded-For. Enable ONLY behind a reverse proxy you control (e.g. Render).
TRUST_PROXY=false
# Protects GET /metrics with "Authorization: Bearer <token>" (min 8 chars). Unset = open.
# METRICS_TOKEN=change-me-long-random
# Hard cap on simultaneous rooms in this process.
MAX_ROOMS=200
# Per-IP WebSocket connection budget (burst, then refill per second). Raise for load tests.
UPGRADE_BURST=60
UPGRADE_REFILL_PER_SEC=2
# Largest WebSocket message accepted, in bytes.
MAX_PAYLOAD_BYTES=8192

# ---- Web app build (apps/web) --------------------------------------------------------------
# Public URL of the game server, baked in at build time. Default: http://localhost:2567
# VITE_SERVER_URL=https://your-server.example.com
