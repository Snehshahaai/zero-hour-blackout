{
  "name": "zero-hour-blackout",
  "version": "0.1.0",
  "private": true,
  "description": "ZERO HOUR: BLACKOUT - browser-based tactical multiplayer FPS",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,cyan \"npm run dev -w @zhb/server\" \"npm run dev -w @zhb/web\"",
    "dev:web": "npm run dev -w @zhb/web",
    "dev:server": "npm run dev -w @zhb/server",
    "build": "npm run build -w @zhb/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
