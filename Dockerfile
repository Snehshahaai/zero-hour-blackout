# ZERO HOUR: BLACKOUT game server.
# Build:  docker build -t zhb-server .      Run:  docker run -p 2567:2567 -e CLIENT_ORIGINS=https://your-site zhb-server
FROM node:22-slim AS build
WORKDIR /app
# Install with the lockfile first so this layer is cached until dependencies change.
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/game-engine/package.json packages/game-engine/
RUN npm ci
COPY tsconfig.base.json ./
COPY apps/server apps/server
COPY packages packages
RUN npm run build -w @zhb/server

FROM node:22-slim
ENV NODE_ENV=production PORT=2567
WORKDIR /app
COPY --from=build /app/apps/server/dist/ ./
# Production dependencies only (pinned by dist/package.json, generated by the build).
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
USER node
EXPOSE 2567
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "index.js"]
